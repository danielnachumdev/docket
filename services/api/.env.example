# SQLite path (default: ./data/docket.db)
# DATABASE_URL=sqlite:///./data/docket.db

# Comma-separated SPA origins for CORS
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Pepper for hashing API tokens — change in any real deploy
TOKEN_PEPPER=dev-only-change-me

# Signed session cookies — change in any real deploy
SESSION_SECRET=dev-only-session-secret
# Set true when the app is served over HTTPS so the session cookie gets Secure.
# Leave false for local HTTP (compose / Vite). HSTS itself belongs at the TLS edge.
# SESSION_COOKIE_SECURE=true

DEBUG=false
